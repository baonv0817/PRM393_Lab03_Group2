{
  "name": "breakbite-seed",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:emulator": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-breakbite \"node seed.mjs --verify\"",
    "seed": "node seed.mjs",
    "set-role": "node set-role.mjs",
    "send-push": "node send-push.mjs",
