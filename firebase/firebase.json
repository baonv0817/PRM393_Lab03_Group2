{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "web-build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(png|jpg|jpeg|svg|otf|ttf|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(js|json|wasm|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "breakbite-1315b",
          "appId": "1:652236973307:android:acc84f8ab88b4bdc3fbc5e",
          "fileOutput": "../mobile/android/app/google-services.json"
        }
      },
      "dart": {
        "../mobile/lib/firebase_options.dart": {
          "projectId": "breakbite-1315b",
          "configurations": {
            "android": "1:652236973307:android:acc84f8ab88b4bdc3fbc5e"
          }
        }
      }
    }
  },
  "remoteconfig": {
    "template": "remote-config-template.json"
  }
}
